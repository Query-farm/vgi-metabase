# -------------------------------------------------- Pro / Enterprise (synthetic)

statement ok
CREATE SECRET mb_ee (TYPE metabase, BASE_URL '{METABASE_EE_FIXTURE_URL}', API_KEY 'mb_test_api_key');

query TTT
SELECT version, edition, usage_analytics FROM metabase.main.instance;
----
v1.65.4.4	enterprise	true

# Default window: the last 30 days of the View log, grouped by day in Metabase.
query TTTII
SELECT content_type, content_id, title, sum(view_count), max(user_count) FROM metabase.main.content_usage GROUP BY ALL ORDER BY ALL;
----
card	40	Revenue by Category	2	1
dashboard	1	E-commerce Insights	1	1
dashboard	2	Sales Overview	4	2

query I
SELECT count(*) FROM metabase.main.content_usage WHERE usage_source <> 'usage_analytics' OR view_date IS NULL OR last_viewed_at IS NULL;
----
0

query TTI
SELECT content_type, content_id, sum(view_count) FROM metabase.main.content_usage WHERE view_date >= current_date - 60 AND content_type = 'card' GROUP BY ALL ORDER BY ALL;
----
card	40	2
card	41	1

# view_date >= current_date - 60 became a 61-day [lower, upper) window plus the content_type filter.
query IT
SELECT date_diff('day', (f->1->>2)::TIMESTAMPTZ, (f->2->>2)::TIMESTAMPTZ), f->3 FROM (SELECT body::JSON->'query'->'filter' AS f FROM read_json('{METABASE_EE_FIXTURE_URL}/__requests?path=/api/dataset') ORDER BY seq DESC LIMIT 1);
----
61	["=",["field","entity_type",{"base-type":"type/Text"}],"card"]

# query_history: the Query log, default window 7 days, newest first.
query IIII
SELECT count(*), count(*) FILTER (WHERE status = 'error'), count(DISTINCT card_id), sum(result_rows) FROM metabase.main.query_history;
----
6	1	2	210

query TTTT
SELECT source, status, message, is_native FROM metabase.main.query_history WHERE status = 'error';
----
question	error	Table "ORDRES" not found	true

query II
SELECT count(*), sum(runtime_seconds)::DECIMAL(9,2) FROM metabase.main.query_history WHERE card_id = '40';
----
2	0.47

query TT
SELECT body::JSON->'query'->'filter'->3, body::JSON->'query'->'order-by' FROM read_json('{METABASE_EE_FIXTURE_URL}/__requests?path=/api/dataset') ORDER BY seq DESC LIMIT 1;
----
["=",["field","card_id",{"base-type":"type/Integer"}],40]	[["desc",["field","started_at",{"base-type":"type/DateTimeWithLocalTZ"}]]]

query I
SELECT count(*) FROM metabase.main.query_history WHERE created_at >= now() - INTERVAL 30 DAY;
----
7

statement ok
DROP SECRET mb_ee;
