# name: test/sql/metabase.test
# description: SQL tests for the metabase worker against the record/replay server (test/mock_api/server.py) and its recording of a real Metabase OSS 0.65 container
# group: [metabase]

require vgi

require-env METABASE_WORKER

require-env METABASE_FIXTURE_URL

require-env METABASE_EE_FIXTURE_URL

# httpfs + json read the replay server's /__requests log to assert what was pushed down.
statement ok
LOAD httpfs;

statement ok
LOAD json;

statement ok
ATTACH 'metabase' (TYPE vgi, LOCATION '{METABASE_WORKER}');

# ---------------------------------------------------------------- secret errors

statement error
SELECT count(*) FROM metabase.main.dashboards;
----
<REGEX>:.*no metabase secret.*

statement ok
CREATE SECRET mb_nocreds (TYPE metabase, BASE_URL '{METABASE_FIXTURE_URL}');

statement error
SELECT count(*) FROM metabase.main.dashboards;
----
<REGEX>:.*set api_key, or username and password.*

statement ok
DROP SECRET mb_nocreds;

statement ok
CREATE SECRET mb_badkey (TYPE metabase, BASE_URL '{METABASE_FIXTURE_URL}', API_KEY 'mb_wrong');

statement error
SELECT count(*) FROM metabase.main.groups;
----
<REGEX>:.*HTTP 401 \(check api_key\).*

statement ok
DROP SECRET mb_badkey;

statement ok
CREATE SECRET mb_badpw (TYPE metabase, BASE_URL '{METABASE_FIXTURE_URL}', USERNAME 'ada@example.com', PASSWORD 'wrong');

statement error
SELECT count(*) FROM metabase.main.groups;
----
<REGEX>:.*login failed with HTTP 401 \(check username / password\).*

statement ok
DROP SECRET mb_badpw;

statement ok
CREATE SECRET mb_insecure (TYPE metabase, BASE_URL 'http://bi.example.com', API_KEY 'k');

statement error
SELECT count(*) FROM metabase.main.groups;
----
<REGEX>:.*https.*

statement ok
DROP SECRET mb_insecure;

# A trailing /api is accepted and dropped; PAGE_SIZE 2 makes the users listing page.
statement ok
CREATE SECRET mb (TYPE metabase, BASE_URL '{METABASE_FIXTURE_URL}/api/', API_KEY 'mb_test_api_key', PAGE_SIZE '2');

# --------------------------------------------------------------------- instance

query TTTTTT
SELECT tool, version, edition, is_hosted, usage_analytics, site_name FROM metabase.main.instance;
----
metabase	v0.65.4.4	oss	false	false	Acme Analytics

