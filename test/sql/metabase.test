FEEDBACK	1
ORDERS	23
PEOPLE	3
PRODUCTS	6

# --------------------------------------------------------------- connections

# Only host, port and the database name leave the connection details: the replay
# server's synthetic connection 99 carries a fake password, SSH key and JDBC options.
query TTTTTT
SELECT id, title, engine, host, port, db_name FROM metabase.main.connections ORDER BY id::INT;
----
1	Sample Database	sqlite	NULL	NULL	/plugins/sample-database.sqlite
99	Warehouse	postgres	db.internal.example.com	5432	analytics

query I
SELECT count(*) FROM metabase.main.connections c WHERE to_json(c)::VARCHAR ILIKE '%secret%' OR to_json(c)::VARCHAR ILIKE '%hunter2%' OR to_json(c)::VARCHAR ILIKE '%metabase_ro%';
----
0

query TT
SELECT title, replace(url, '{METABASE_FIXTURE_URL}', '') FROM metabase.main.connections WHERE id = '99';
----
Warehouse	/admin/databases/99

