# The API key's own recent views (the dashboards dashboard_cards read count as views).
query I
SELECT count(*) FROM metabase.main.recent_views;
----
2

# OSS: lifetime counters, no per-day rows.
query TTTTITT
SELECT content_type, content_id, title, view_date, view_count, user_count, usage_source FROM metabase.main.content_usage WHERE content_id IN ('2', '40', '41') ORDER BY content_type, content_id;
----
card	2	Revenue by state	NULL	0	NULL	lifetime_counters
card	40	Revenue by Category	NULL	3	NULL	lifetime_counters
card	41	Orders by Category (SQL)	NULL	2	NULL	lifetime_counters
dashboard	2	Sales Overview	NULL	7	NULL	lifetime_counters

statement error
SELECT count(*) FROM metabase.main.query_history;
