# Recipient addresses never reach SQL.
query I
SELECT count(*) FROM (SELECT to_json(s)::VARCHAR AS j FROM metabase.main.subscriptions s UNION ALL SELECT to_json(a)::VARCHAR FROM metabase.main.alerts a) WHERE j LIKE '%cfo@%' OR j LIKE '%ops@%' OR j LIKE '%grace@%';
----
0

