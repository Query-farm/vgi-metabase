# ------------------------------------------------------------------- queries

query TTT
SELECT id, query_type, replace(native_sql, chr(10), ' | ') FROM metabase.main.queries WHERE id = '41';
----
41	native	SELECT p.CATEGORY, count(*) AS ORDERS, sum(o.TOTAL) AS REVENUE, max(o.CREATED_AT) AS LAST_ORDER | FROM ORDERS o JOIN PRODUCTS p ON p.ID = o.PRODUCT_ID | WHERE p.CATEGORY = {{category}} | GROUP BY p.CATEGORY

query TTTTT
SELECT t.name, t.type, t.display_name, t.default_value, t.required FROM metabase.main.queries q, unnest(q.template_tags) AS x(t) WHERE q.id = '41';
----
category	text	Category	Widget	NULL

query TTTTT
SELECT id, source_table_ids, source_card_ids, mbql_format, native_sql IS NULL FROM metabase.main.queries WHERE id IN ('40', '42', '45') ORDER BY id;
----
40	[2, 3]	[]	pmbql	true
42	[2]	[]	pmbql	true
45	[]	[42]	pmbql	true

query T
SELECT dataset_query->>'$.stages[0].source-card' FROM metabase.main.queries WHERE card_id = '45';
----
42

# ------------------------------------------------------------------- lineage

query TTTTTTT
SELECT card_id, role, join_alias, table_id, source_card_id, table_name, database_name FROM metabase.main.card_tables WHERE card_id IN ('40', '45') ORDER BY card_id, role DESC;
